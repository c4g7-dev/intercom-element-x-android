<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- To tell whether a download would go over mobile data. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- InterCom installs its own updates, which it downloads from the releases of its repository. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets Android 12 and newer install such an update without a confirmation, see DefaultApkInstaller. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- To open Samsung's Auto Blocker, which stops installs from outside a store, see InstallHintSettings. -->
    <queries>
        <package android:name="com.samsung.android.rampart" />
    </queries>

    <application>
        <receiver
            android:name=".install.InterComUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
